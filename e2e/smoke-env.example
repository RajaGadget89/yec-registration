# API Smoke Test Environment Configuration
# Copy this to .env.local or e2e/.env and fill in your values

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Test Mode Flags (REQUIRED)
E2E_TEST_MODE=true
TEST_HELPERS_ENABLED=1
E2E_AUTH_SECRET=your-secret-here

# Feature Flags (REQUIRED)
FEATURES_ADMIN_MANAGEMENT=true
FEATURES_ADMIN_JOB_ASSIGNMENT=true

# Test Actor Emails (REQUIRED)
# These must be valid admin emails in your system
SUPER_ADMIN_EMAIL=super@example.com
PAYMENT_ONLY_EMAIL=payment@example.com
TCC_ONLY_EMAIL=tcc@example.com

# Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RBAC Environment Variables (REQUIRED)
# These should match your admin user assignments
SUPER_ADMIN_EMAILS=super@example.com
ADMIN_PAYMENT_EMAILS=payment@example.com
ADMIN_PROFILE_EMAILS=profile@example.com
ADMIN_TCC_EMAILS=tcc@example.com
